# ─── Application ─────────────────────────────────────────────
OCR2R_ENV=development
OCR2R_LOG_LEVEL=INFO
OCR2R_LOG_FORMAT=json
OCR2R_API_HOST=0.0.0.0
OCR2R_API_PORT=8000
OCR2R_API_WORKERS=1

# ─── Database ────────────────────────────────────────────────
OCR2R_DATABASE_URL=postgresql+psycopg://ocr2r:ocr2r@localhost:5432/ocr2r

# ─── Redis (queue + cache + rate limit) ─────────────────────
OCR2R_REDIS_URL=redis://localhost:6379/0

# ─── Blob storage (S3-compatible) ───────────────────────────
OCR2R_BLOB_ENDPOINT_URL=http://localhost:9000
OCR2R_BLOB_BUCKET=ocr2r
OCR2R_BLOB_ACCESS_KEY=minioadmin
OCR2R_BLOB_SECRET_KEY=minioadmin
OCR2R_BLOB_REGION=us-east-1

# ─── Master Key Encryption Key (KEK) for envelope encryption ─
# 32 bytes base64-encoded. Generate with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
OCR2R_KEK_B64=

# ─── JWT signing (ES256) ─────────────────────────────────────
# PEM-encoded EC P-256 private key. Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out jwt-private.pem
OCR2R_JWT_PRIVATE_KEY_PEM=

# ─── Vision provider keys (only enable what you use) ────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Egress allowlist (comma-separated hostnames) ───────────
OCR2R_EGRESS_ALLOWLIST=api.anthropic.com,api.openai.com

# ─── Live test budgets ──────────────────────────────────────
LIVE_TESTS=0
LIVE_TESTS_USD_BUDGET_DAILY=5
